# ---- Discord bot ----
# The bot's login token. Developer Portal -> your application -> Bot -> Reset Token. Keep this secret.
BOT_TOKEN=
# Your Discord user ID. Only this user can run /stfu (shuts the bot down).
BOT_OWNER_ID=
# The bot's application ID. Developer Portal -> General Information -> Application ID. Used by deploy-commands.js.
CLIENT_ID=
# The server ID the slash commands are registered to by deploy-commands.js (right-click server icon -> Copy Server ID).
GUILD_ID=

# ---- Channels, categories and roles ----
# These aren't set here any more. Run /settings in Discord (server admins only) and pick them from lists.
# If an older .env still has lines like VERIFIED_ROLE_ID=, the bot copies them into its database once, on its
# first start with /settings, and ignores them after that.

# ---- Verification ----
# Archived ticket channels with no messages for this many days are deleted automatically (checked hourly).
# Only channels named verify-... in the archive category are touched. Keeps the category under Discord's 50-channel limit.
# Mods can change this from Discord with /verify-config (it rewrites this line).
ARCHIVED_TICKET_RETENTION_DAYS=7
# Rename MEE6 tickets by type. Format: Phrase:prefix, comma-separated. When the topic MEE6 sets on a new ticket channel
# contains the phrase (capitals don't matter), the channel's first part is swapped for the prefix: 0001-name -> force-name.
# Leave empty to turn this off.
MEE6_TICKET_RENAMES=

# ---- Verification: behaviour ----
# shadow = only log what the bot would do (mods verify by hand). live = the bot grants roles, opens tickets, etc.
VERIFY_MODE=shadow
# Auto-approved members get Verified after a random delay in this range, so instant approval doesn't reveal
# the automation. Production: 60 and 300. Use 0 and 0 while testing.
VERIFY_GRANT_DELAY_MIN_SECONDS=60
VERIFY_GRANT_DELAY_MAX_SECONDS=300
# Seconds a member must wait between Verify submissions (protects the lookup sites' rate limits).
# A rejected typo (invalid name) does not start the wait. 0 turns the cooldown off. npm run dev always uses 0.
VERIFY_COOLDOWN_SECONDS=60
# Raid protection: if more than RAID_SUBMISSIONS_THRESHOLD Verify submissions arrive within RAID_WINDOW_SECONDS,
# verification pauses for RAID_PAUSE_MINUTES and mods are alerted in the log channel. Members are asked to try again later.
# The pause is extended if submissions keep pouring in. 20 per 60 s is about as fast as the bot can look characters up.
RAID_SUBMISSIONS_THRESHOLD=20
RAID_WINDOW_SECONDS=60
RAID_PAUSE_MINUTES=10
# Run /recheck-members for everyone automatically once a day at this time (24-hour HH:MM, the bot machine's local time).
# The results are posted in the log channel. Skipped if a re-check is already running. Leave empty to turn this off.
# Mods can change this from Discord with /verify-config (it rewrites this line; "off" empties it).
DAILY_RECHECK_TIME=
# Time zone for DAILY_RECHECK_TIME, as a tz database name (Europe/Helsinki follows EET/EEST).
# Empty = Europe/Helsinki.
TIMEZONE=Europe/Helsinki

# ---- Comp editing timeslots (/create-timeslots) ----
# /create-timeslots posts a board where Force Leaders book their own date and start time to edit the comp.
# How long each timeslot is, in minutes.
TIMESLOT_DURATION=30
# Timeslots must end at least this many hours before the event starts.
TIMESLOT_MIN_HOURS_BEFORE_EVENT=3
# Mods can change both from Discord with /verify-config (it rewrites these lines).

# ---- Verification: requirements ----
# Faction the character must belong to, as the game names it (Asmodians or Elyos).
REQUIRED_FACTION=Asmodians
# Server the character must be on, as the game names it. Keep PLAYNC_SERVER_ID, SHUGO_REGION_PATH and
# AION2INDEX_REGION_PATH in sync.
REQUIRED_SERVER=Israphel
# Minimum character level. Below this: a review ticket (or denied if the Discord account is also too new).
# Mods can change this from Discord with /verify-config (it rewrites this line).
MIN_LEVEL=45
# Minimum gear score (the character's item level). Below this: a review ticket (or denied if the account is also too new).
# Mods can change this from Discord with /verify-config (it rewrites this line).
MIN_GS=2100
# Discord accounts younger than this many days get a review ticket instead of being verified automatically.
# Mods can change this from Discord with /verify-config (it rewrites this line).
MIN_ACCOUNT_AGE_DAYS=90
# true = members below MIN_LEVEL or MIN_GS are turned away with the reason (no review ticket).
# false = they get a review ticket so an officer can decide. Young accounts with a valid character always get a ticket.
# Mods can change this from Discord with /verify-config (it rewrites this line).
STRICT_VERIFICATION=false
# Gear slots the bot picks from at random when it asks a ticket member for a screenshot with one item unequipped.
# Comma-separated slot names. Slots the character actually has equipped are preferred
# (the official site and shugo.gg report gear; with aion2index the bot picks from the whole list).
# Available: MainHand, SubHand, Helmet, Shoulder, Torso, Pants, Gloves, Boots, Cape, Belt, Necklace, Amulet,
#            Earring1, Earring2, Ring1, Ring2, Bracelet1, Bracelet2, Rune1, Rune2, Arcana1-5
TICKET_GEAR_SLOTS=Helmet,Shoulder,Torso,Pants,Gloves,Boots,Cape,Belt,Necklace,Amulet,Earring1,Earring2,Ring1,Ring2,Bracelet1,Bracelet2

# Longest character name members can type in the Verify pop-up. Longer names are rejected before any lookup.
MAX_CHARACTER_NAME_LENGTH=32

# ---- Character lookup sites ----
# Which sites to look characters up on, in order: the first is used, the next only when it fails.
# plaync (the official AION 2 site), aion2index and shugo, in any order. Example: plaync,aion2index,shugo
# (the official site first, aion2index and then shugo.gg as backups).
LOOKUP_SOURCES=plaync,aion2index,shugo
# After a site fails, use the next one in LOOKUP_SOURCES for this many minutes before trying it again.
LOOKUP_FAILOVER_MINUTES=5

# ---- Official AION 2 site (aion2.plaync.com) ----
# The bot reads characters from the same place NCSOFT's own character page does. No key needed.
# It isn't an official, documented service, so it can change without warning. Keep a backup site in LOOKUP_SOURCES.
# Everything here has a default, so these lines can stay as they are.
# Game region: eu (Europe), nae (North America), as (Asia), la (Latin America).
PLAYNC_REGION=eu
# The game server's number on the official site. Israphel is 2301. Must match REQUIRED_SERVER.
PLAYNC_SERVER_ID=2301
# Minimum milliseconds between two lookups. Each lookup is 3 requests (search, profile, gear).
# NCSOFT doesn't publish a limit, so stay gentle.
PLAYNC_MIN_REQUEST_GAP_MS=2000
# Addresses of the name search and of the character pages (no trailing slash). Only change if NCSOFT moves them.
PLAYNC_SEARCH_URL=https://api-search.plaync.com/aion2global/search/v2/character
PLAYNC_BASE_URL=https://aion2.plaync.com

# ---- aion2index.com API ----
# API key from your aion2index community panel (request access at https://aion2index.com/communities/docs).
# Required when LOOKUP_SOURCES includes aion2index. Keep it secret.
AION2INDEX_API_KEY=
AION2INDEX_BASE_URL=https://aion2index.com/api/v1/characters
# <region>/<server slug>. Must match REQUIRED_SERVER.
AION2INDEX_REGION_PATH=eu/israphel
# Minimum milliseconds between two aion2index lookups. Set from the per-minute limit in your panel
# (60 per minute -> 1000, with room to spare -> 1500).
AION2INDEX_MIN_REQUEST_GAP_MS=1500

# ---- Force rosters (/announce-roster, /reset-force-vcs) ----
# Optional raid-helper API key (/apikey in Discord). Comps load without it; with it, raid-helper rate-limits the key
# instead of the bot's IP address.
RAID_HELPER_API_KEY=

# ---- shugo.gg ----
# The SHUGO_USER_AGENT, SHUGO_REQUEST_TIMEOUT_MS, SHUGO_CACHE_TTL_MS and SHUGO_HEALTHCHECK_CHARACTER settings
# below apply to aion2index too.
# Base address of shugo.gg character pages (no trailing slash).
SHUGO_BASE_URL=https://shugo.gg/character
# Region/server part of the page address. Lookups go to <SHUGO_BASE_URL>/<SHUGO_REGION_PATH>/<name>.
# Must match REQUIRED_SERVER, otherwise every name will look like it doesn't exist.
SHUGO_REGION_PATH=global/eu-israphel
# How the bot identifies itself to the lookup sites on each request.
SHUGO_USER_AGENT="OrcaBot/1.0 (Discord faction verification)"
# Give up on a lookup after this many milliseconds; the next site is tried, or the member goes to the mod queue.
SHUGO_REQUEST_TIMEOUT_MS=15000
# Minimum milliseconds between two lookups. shugo.gg allows 300 requests per 10 minutes (one per 2000 ms);
# 3000 keeps the bot at about 200, leaving room for you browsing the site from the same connection.
SHUGO_MIN_REQUEST_GAP_MS=3000
# How long (milliseconds) a lookup result is reused before the sites are asked again for the same name.
SHUGO_CACHE_TTL_MS=60000
# A character that definitely exists on your server and faction (e.g. your own). The bot looks it up on every site in
# LOOKUP_SOURCES on startup and warns in the log channel if one is down, changed its data, or shows the wrong
# faction/server. Leave empty to skip.
SHUGO_HEALTHCHECK_CHARACTER=
