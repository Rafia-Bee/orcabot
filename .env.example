# ---- Discord bot ----
# The bot's login token. Developer Portal -> your application -> Bot -> Reset Token. Keep this secret.
BOT_TOKEN=
# Your Discord user ID. Only this user can run /stfu (shuts the bot down).
BOT_OWNER_ID=
# The bot's application ID. Developer Portal -> General Information -> Application ID. Used by deploy-commands.js.
CLIENT_ID=
# The server ID the slash commands are registered to by deploy-commands.js (right-click server icon -> Copy Server ID).
GUILD_ID=

# ---- Verification: roles and channels (right-click -> Copy ID, with Developer Mode on) ----
# Role given to verified members. The bot's role must be above it in Server Settings -> Roles.
VERIFIED_ROLE_ID=
# Channel where /verify-setup posts the Verify button. Visible to @everyone, hidden from Verified.
VERIFY_CHANNEL_ID=
# Mods-only channel where the bot logs every submission and decision (with shugo.gg links and account age).
VERIFY_LOG_CHANNEL_ID=
# Mods-only channel for review cases with Approve/Deny buttons (shugo.gg down, character already claimed, ticket failed).
VERIFY_REVIEW_CHANNEL_ID=
# Category where the bot creates private ticket channels (young accounts, low level or gear score).
# Discord allows at most 50 channels per category.
REVIEW_TICKETS_CATEGORY_ID=
# Role that can see ticket channels and use their Verify/Ban buttons (Administrators can too).
OFFICERS_ROLE_ID=
# Alliance legion roles, given together with Verified. Format: LegionName:roleId, comma-separated. Legion names must match
# shugo.gg (capitals don't matter). Members whose legion isn't listed get GUEST_ROLE_ID. Leave both empty to turn this off.
# Example: LEGION_ROLES=Aegis:111,SDC:222,Failure:333,IDF:444,Sabotage:555,通通200:666
LEGION_ROLES=
# Role for verified members who aren't in any LEGION_ROLES legion.
GUEST_ROLE_ID=
# Category closed tickets are moved to after Verify or Ban. The member loses access; officers keep it.
ARCHIVED_REVIEW_TICKETS_CATEGORY_ID=
# Archived ticket channels with no messages for this many days are deleted automatically (checked hourly).
# Only channels named verify-... in the archive category are touched. Keeps the category under Discord's 50-channel limit.
# Mods can change this from Discord with /verify-config (it rewrites this line).
ARCHIVED_TICKET_RETENTION_DAYS=7

# ---- Verification: behaviour ----
# shadow = only log what the bot would do (mods verify by hand). live = the bot grants roles, opens tickets, etc.
VERIFY_MODE=shadow
# Auto-approved members get Verified after a random delay in this range, so instant approval doesn't reveal
# the automation. Production: 60 and 300. Use 0 and 0 while testing.
VERIFY_GRANT_DELAY_MIN_SECONDS=60
VERIFY_GRANT_DELAY_MAX_SECONDS=300
# Seconds a member must wait between Verify submissions (protects the shugo.gg rate limit).
# A rejected typo (invalid name) does not start the wait. 0 turns the cooldown off. npm run dev always uses 0.
VERIFY_COOLDOWN_SECONDS=60
# Raid protection: if more than RAID_SUBMISSIONS_THRESHOLD Verify submissions arrive within RAID_WINDOW_SECONDS,
# verification pauses for RAID_PAUSE_MINUTES and mods are alerted in the log channel. Members are asked to try again later.
# The pause is extended if submissions keep pouring in. 20 per 60 s is about as fast as the bot can look characters up.
RAID_SUBMISSIONS_THRESHOLD=20
RAID_WINDOW_SECONDS=60
RAID_PAUSE_MINUTES=10

# ---- Verification: requirements ----
# Faction the character must belong to, exactly as shugo.gg shows it (Asmodians or Elyos).
REQUIRED_FACTION=Asmodians
# Server the character must be on, as shugo.gg shows it. Keep SHUGO_REGION_PATH in sync.
REQUIRED_SERVER=Israphel
# Minimum character level. Below this: a review ticket (or denied if the Discord account is also too new).
# Mods can change this from Discord with /verify-config (it rewrites this line).
MIN_LEVEL=45
# Minimum gear score (shugo.gg's item level). Below this: a review ticket (or denied if the account is also too new).
# Mods can change this from Discord with /verify-config (it rewrites this line).
MIN_GS=2100
# Discord accounts younger than this many days get a review ticket instead of being verified automatically.
# Mods can change this from Discord with /verify-config (it rewrites this line).
MIN_ACCOUNT_AGE_DAYS=90
# true = members below MIN_LEVEL or MIN_GS are turned away with the reason (no review ticket).
# false = they get a review ticket so an officer can decide. Young accounts with a valid character always get a ticket.
# Mods can change this from Discord with /verify-config (it rewrites this line).
STRICT_VERIFICATION=false
# Gear slots the bot picks from at random when it asks a ticket member for a screenshot with one item unequipped.
# Comma-separated shugo.gg slot names. Slots the character actually has equipped are preferred.
# Available: MainHand, SubHand, Helmet, Shoulder, Torso, Pants, Gloves, Boots, Cape, Belt, Necklace, Amulet,
#            Earring1, Earring2, Ring1, Ring2, Bracelet1, Bracelet2, Rune1, Rune2, Arcana1-5
TICKET_GEAR_SLOTS=Helmet,Shoulder,Torso,Pants,Gloves,Boots,Cape,Belt,Necklace,Amulet,Earring1,Earring2,Ring1,Ring2,Bracelet1,Bracelet2

# Longest character name members can type in the Verify pop-up. Longer names are rejected before any lookup.
MAX_CHARACTER_NAME_LENGTH=32

# ---- shugo.gg character lookups ----
# Base address of shugo.gg character pages (no trailing slash).
SHUGO_BASE_URL=https://shugo.gg/character
# Region/server part of the page address. Lookups go to <SHUGO_BASE_URL>/<SHUGO_REGION_PATH>/<name>.
# Must match REQUIRED_SERVER, otherwise every name will look like it doesn't exist.
SHUGO_REGION_PATH=global/eu-israphel
# How the bot identifies itself to shugo.gg on each request.
SHUGO_USER_AGENT="OrcaBot/1.0 (Discord faction verification)"
# Give up on a lookup after this many milliseconds; the member is then sent to the mod queue.
SHUGO_REQUEST_TIMEOUT_MS=15000
# Minimum milliseconds between two lookups. shugo.gg allows 300 requests per 10 minutes (one per 2000 ms);
# 3000 keeps the bot at about 200, leaving room for you browsing the site from the same connection.
SHUGO_MIN_REQUEST_GAP_MS=3000
# How long (milliseconds) a lookup result is reused before shugo.gg is asked again for the same name.
SHUGO_CACHE_TTL_MS=60000
# A character that definitely exists on your server and faction (e.g. your own). The bot looks it up on startup and
# warns in the log channel if shugo.gg is down, changed its page layout, or shows the wrong faction/server. Leave empty to skip.
SHUGO_HEALTHCHECK_CHARACTER=
